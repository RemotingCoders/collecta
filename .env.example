# Copy this file to .env and fill in the values. .env is git-ignored. Never commit real credentials.

# PayPal SANDBOX REST app (tests/smoke-test.ps1 and seed/seed.py).
# From https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Sandbox Personal (buyer) account that receives and pays the demo invoices (seed/seed.py).
PAYPAL_BUYER_EMAIL=sb-h2ndk53805691@personal.example.com

# Dynamics 365 Sales environment (seed/seed.py). Sign-in is interactive; no secret is needed.
DATAVERSE_URL=https://collecta.crm.dynamics.com
# Optional: tenant ID or domain. Default: organizations
# DATAVERSE_TENANT_ID=
# Optional: public client ID used for the sign-in. Default: Microsoft's Dataverse tooling app.
# DATAVERSE_CLIENT_ID=51f81489-12ee-4a9e-aaae-a2591f45987d
# Optional: user who gets the read-only "Collecta Reviewer" role. Default: judge@remotingcoders.com
# COLLECTA_REVIEWER_USER=
