          <IsRetrievable>0</IsRetrievable>
          <IsLocalizable>0</IsLocalizable>
          <AppDefaultValue>-1</AppDefaultValue>
          <optionset Name="rc_invoice_rc_paypalstatus">
            <OptionSetType>picklist</OptionSetType>
            <IntroducedVersion>1.0.0.0</IntroducedVersion>
            <IsCustomizable>1</IsCustomizable>
            <displaynames>
              <displayname description="PayPal Status" languagecode="1033" />
            </displaynames>
            <Descriptions>
              <Description description="The status of the invoice in PayPal." languagecode="1033" />
            </Descriptions>
            <options>
              <option value="710000000" ExternalValue="" IsHidden="0">
                <labels>
                  <label description="Not sent" languagecode="1033" />
                </labels>
                <Descriptions>
                  <Description description="The invoice has not been sent through PayPal; no PayPal invoice exists for it. Nothing is tracked in PayPal yet." languagecode="1033" />
                </Descriptions>
              </option>
              <option value="710000001" ExternalValue="" IsHidden="0">
                <labels>
                  <label description="Draft" languagecode="1033" />
                </labels>
                <Descriptions>
                  <Description description="A PayPal invoice exists but has not been sent to the customer (PayPal status DRAFT). The customer cannot pay it yet." languagecode="1033" />
                </Descriptions>
              </option>
              <option value="710000002" ExternalValue="" IsHidden="0">
                <labels>
                  <label description="Sent" languagecode="1033" />
                </labels>
                <Descriptions>
                  <Description description="Sent to the customer through PayPal and not paid (PayPal status SENT, SCHEDULED, SHARED or PAYMENT_PENDING). The full amount is owed." languagecode="1033" />
                </Descriptions>
              </option>
              <option value="710000003" ExternalValue="" IsHidden="0">
                <labels>
                  <label description="Unpaid" languagecode="1033" />
                </labels>
                <Descriptions>
                  <Description description="Sent through PayPal and still unpaid (PayPal status UNPAID). The full amount is owed." languagecode="1033" />
                </Descriptions>
              </option>
              <option value="710000004" ExternalValue="" IsHidden="0">
                <labels>
                  <label description="Partially paid" languagecode="1033" />
                </labels>
                <Descriptions>
                  <Description description="One or more payments received, balance still due (PayPal status PARTIALLY_PAID or MARKED_AS_PARTIALLY_PAID). The customer still owes the PayPal Amount Due." languagecode="1033" />
                </Descriptions>
              </option>
              <option value="710000005" ExternalValue="" IsHidden="0">
                <labels>
                  <label description="Paid" languagecode="1033" />
                </labels>
                <Descriptions>
                  <Description description="Fully paid (PayPal status PAID, MARKED_AS_PAID or PAID_EXTERNAL). Nothing is owed; the Dynamics 365 invoice is closed as Paid. Refunded invoices also show Paid." languagecode="1033" />
                </Descriptions>
              </option>
              <option value="710000006" ExternalValue="" IsHidden="0">
                <labels>
                  <label description="Cancelled" languagecode="1033" />
                </labels>
                <Descriptions>
                  <Description description="The PayPal invoice was cancelled (PayPal status CANCELLED or AUTO_CANCELLED). Nothing is owed through PayPal." languagecode="1033" />
                </Descriptions>
              </option>
            </options>
          </optionset>
          <displaynames>
            <displayname description="PayPal Status" languagecode="1033" />
          </displaynames>
          <Descriptions>
            <Description description="Payment status of this invoice in PayPal, synchronized from PayPal (the source of truth). Not sent = never sent through PayPal; Draft; Sent = sent and unpaid; Unpaid; Partially paid = some payments received, balance still due; Paid = fully paid; Cancelled. An invoice is 'unpaid' or 'owed' when the status is Sent, Unpaid or Partially paid." languagecode="1033" />
          </Descriptions>
        </attribute>
